  // features
  "feature.visited-map-labels.name": "Area names on the map",
  "feature.visited-map-labels.description": "Names the areas of the world map (Mountains, Pelican Town...), only those you've already been to. Handy for quests and fishing events which name a place.",

  "feature.caught-fish-tooltip.name": "Fishing info for caught fish",
  "feature.caught-fish-tooltip.description": "Adds the catch conditions (water, seasons, weather, hours) to the tooltip of fish you've already caught. Seasons and water only consider places you've visited.",

  "feature.minimap.name": "Minimap",
  "feature.minimap.description": "Shows a minimap of the current place in the top-left corner, with the villagers you've met. Page Up / Page Down to zoom in and out.",

  "feature.social-locations.name": "Villager locations in the social tab",
  "feature.social-locations.description": "Shows where each villager currently is, under their hearts. Places you've never visited stay hidden.",

  // map areas the game doesn't name itself
