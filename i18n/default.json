  "map-area.GingerIsland.West": "West Island",

  "option.minimap-opacity": "Minimap opacity",
  "option.minimap-opacity.description": "How visible the minimap is. Slide left to make it discreet.",

  "cc.needed": "Community center — bring to: {{value}}",
  "cc.donated": "Community center — already handed in: {{value}}",
  "cc.better-quality": "Community center — needs a better quality: {{value}}",

  "museum.wanted": "Museum — not donated yet",

  "map.toggle-labels": "Area names",
  "map.toggle-labels.description": "Show or hide the area names on the map.",

  "feature.community-center-hints.name": "Community center reminders",
  "feature.community-center-hints.description": "Marks items a bundle still needs, so you don't sell them by mistake, and says when one was already handed in. Only covers rooms whose note is already showing.",

  "feature.museum-hints.name": "Museum reminders",
  "feature.museum-hints.description": "Marks minerals and artifacts the museum hasn't got yet, and ticks the ones you've already donated. Only after you've been to the museum.",

  "feature.farm-layers.name": "Farm layers (F3)",
  "feature.farm-layers.description": "While holding a sprinkler or a scarecrow, shades what it would cover from where you're standing, plus what the ones already placed cover. F3 cycles the layers by hand: sprinklers, scarecrows, both, off. The key can be changed in config.json.",

  "feature.animal-care.name": "Animal reminders",
  "feature.animal-care.description": "A small icon above an animal which still needs petting, milking or shearing today. Nothing at all once it's done.",

  "farm-layers.sprinklers": "Layer: sprinklers",
  "farm-layers.scarecrows": "Layer: scarecrows",
  "farm-layers.all": "Layers: sprinklers + scarecrows",
  "farm-layers.off": "Layers off",

  "feature.purchase-confirm.name": "Confirm shop purchases",
  "feature.purchase-confirm.description": "Asks how many to buy before any purchase: type the number and press Enter, with the total and a cancel button. Also saves shift-clicking to buy in bulk.",

  "shop.quantity": "How many {{item}}?",

  "feature.transfer-quantity.name": "Choose the quantity (Ctrl + click)",
  "feature.transfer-quantity.description": "In a chest or fridge, Ctrl + click a stack: type the number you want and press Enter, and exactly that many move to the other side. Works both ways. The key can be changed in config.json.",

  "transfer.take": "How many \"{{item}}\" to take? ({{count}} in the chest)",
  "transfer.store": "How many \"{{item}}\" to store? ({{count}} in your bag)",
  "transfer.no-room": "No room left for them.",
  "transfer.partial": "Only {{count}} could be moved: there's no room left.",

  "feature.horse-actions.name": "Actions on horseback",
  "feature.horse-actions.description": "On horseback, chests, machines, the shipping bin, fish ponds and the mailbox work without getting off. A door takes you inside and leaves the horse outside. And once you're off, you walk through your horse instead of being blocked.",

  "feature.deposit-everywhere.name": "Put away everywhere",
  "feature.deposit-everywhere.description": "In a farm chest (house, buildings and fridge included), a button sends each item in your bag to the chest which already holds the most of it, whatever its quality. Only the item in your hand and your tools stay, and an item with no chest of its own stays in the bag.",
  "feature.move-objects.name": "Move an object (Shift + click)",
  "feature.move-objects.description": "Shift + click a chest, machine or decoration: it follows the cursor, and a click puts it down elsewhere, with all its contents and progress. On the farm it can be taken into a building (the house, the hutch...): it stays where it is until put down. Escape to cancel. Hover a farm building and click: the object goes inside, on the free spot nearest the door. Tappers on trees, crab pots in water and garden pots stay put. The key can be changed in config.json.",
  "feature.craft-from-chests.name": "Craft with the farm's chests",
  "feature.craft-from-chests.description": "On the farm, crafting, cooking and the workbench also use what's in your farm chests, as if it were in your bag. Elsewhere (mines, town), nothing changes. In multiplayer, each chest used is reserved while the screen is open, like the game's kitchen: host and farmhand both get every farm chest, except one the other player has open at that moment.",
  "feature.phone-orders.name": "Order by phone (Clint, Robin, Marnie)",
  "feature.phone-orders.description": "When Clint, Robin or Marnie picks up (opening hours, no festival), you can order from their prices on the phone: tool upgrades, house upgrades, buildings, animals, and Marnie's shop (buying only: hay, supplies). Gold comes from your wallet, materials from your bag then the farm's chests. The upgraded tool is still collected at the forge.",
  "feature.pause-together.name": "Pause together (multiplayer)",
  "feature.pause-together.description": "In multiplayer, time stops while you're all in a menu (inventory, chest, dialogue...), as a menu does in single-player. If only one player is in a menu, time keeps going. Everyone needs the mod. The host can also type /pause in the chat to stop everything.",
  "feature.shared-quests.name": "Shared letter quests (multiplayer)",
  "feature.shared-quests.description": "Requests received by letter (Caroline's pumpkin, the mayor's shorts...): when one of you finishes it, it's finished for the others too, with the same reward (money to claim in the journal, and friendship). Story quests stay each player's own.",

  "deposit.title": "Put away everywhere",
  "deposit.hover": "Sends each item in your bag to the farm chest\nwhich already holds it.\nThe item in your hand stays.",
  "deposit.nothing": "Nothing to put away: no farm chest holds these items.",
  "deposit.done": "Put away in {{chests}} chest(s): {{items}}",
  "deposit.full": "No room left in their chest for: {{items}}",
  "deposit.more": "and {{count}} more",

  "feature.recipe-lookup.name": "Recipes using this item (R)",
  "feature.recipe-lookup.description": "Hover an item and press R to see which of your known recipes use it, what each one still needs, and which chest holds the rest. The key can be changed in config.json.",

  "feature.fish-hints.name": "Hints for missing fish",
  "feature.fish-hints.description": "In the collections tab, describes a fish you have never caught by comparing it to the ones you have: \"Season: same as that fish\". Anything your own catches cannot express stays as ????, and a fish which only lives somewhere you have never been says nothing at all.",
  "feature.collection-hints.name": "Where minerals and artifacts come from",
  "feature.collection-hints.description": "In Collections, a mineral or artifact silhouette says where it can come from (geode, artifact spots, monster, mine, fishing...). A geode's tooltip says how many new items it can still give you. A source you've never met is never named.",
  "feature.mine-boards.name": "Mine and cavern boards",
  "feature.mine-boards.description": "A note pinned on the wall by the mines' elevator switch describes each zone you've reached (ores, gems, geodes, monsters); another at the Skull Cavern entrance gives your record, how common iridium is down to your record, and your trip records (kept from installation). Click it like a sign.",

  "fish-hints.title": "Going by your catches:",
  "fish-hints.unreachable": "You have never fished where it lives.",
  "fish-hints.like": "same as \"{{fish}}\"",
  "fish-hints.unknown": "????",
  "fish-hints.any-season": "all year round",
  "fish-hints.any-weather": "any weather",
  "fish-hints.any-time": "any time of day",
