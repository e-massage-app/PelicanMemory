  "feature.caught-fish-tooltip.name": "Infos de pêche des poissons attrapés",
  "feature.caught-fish-tooltip.description": "Ajoute les conditions de capture (eau, saisons, météo, horaires) à l'infobulle des poissons déjà attrapés. Saisons et eau ne tiennent compte que des lieux visités.",

  "feature.minimap.name": "Minimap",
  "feature.minimap.description": "Affiche une minimap du lieu courant en haut à gauche, avec les villageois déjà rencontrés. Page préc. / Page suiv. pour zoomer et dézoomer.",

  "feature.social-locations.name": "Position des villageois dans l'onglet Relations",
